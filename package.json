{
  "name": "@wpsydev/liquid-glass",
  "version": "0.20.0-preview.1",
  "description": "Liquid Glass for the web: dependency-free CSS and TypeScript, React and Vue adapters, accessible fallbacks, and agent-ready recipes.",
  "type": "module",
  "license": "MIT",
  "author": "wpsydev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wpsydev/liquid-glass-kit.git"
  },
  "homepage": "https://wpsydev.github.io/liquid-glass-kit/",
  "bugs": "https://github.com/wpsydev/liquid-glass-kit/issues",
  "keywords": [
    "liquid-glass",
    "ios",
    "glassmorphism",
    "refraction",
    "react",
    "vue",
    "svelte",
    "nextjs",
    "astro",
    "tailwind",
    "ai",
    "agents",
    "ui",
    "accessibility",
    "webgl",
    "instancing",
    "animation",
    "css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "skills",
    "llms.txt",
    "llms-full.txt",
    "docs/*.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./scene": {
      "types": "./dist/scene.d.ts",
      "import": "./dist/scene.js"
    },
    "./material": {
      "types": "./dist/material.d.ts",
      "import": "./dist/material.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./indicator": {
      "types": "./dist/indicator.d.ts",
      "import": "./dist/indicator.js"
    },
    "./scroll-edge": {
      "types": "./dist/scroll-edge.d.ts",
      "import": "./dist/scroll-edge.js"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "import": "./dist/overlay.js"
    },
    "./micro-motion": {
      "types": "./dist/micro-motion.d.ts",
      "import": "./dist/micro-motion.js"
    },
    "./optics": {
      "types": "./dist/optics.d.ts",
      "import": "./dist/optics.js"
    },
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "import": "./dist/lazy.js"
    },
    "./material.css": "./dist/material.css",
    "./motion.css": "./dist/motion.css",
    "./indicator.css": "./dist/indicator.css",
    "./scroll-edge.css": "./dist/scroll-edge.css",
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./workbench.css": "./dist/workbench.css",
    "./dock": {
      "types": "./dist/dock.d.ts",
      "import": "./dist/dock.js"
    },
    "./dock.css": "./dist/dock.css",
    "./scroll-reveal": {
      "types": "./dist/scroll-reveal.d.ts",
      "import": "./dist/scroll-reveal.js"
    },
    "./activity-island": {
      "types": "./dist/activity-island.d.ts",
      "import": "./dist/activity-island.js"
    },
    "./activity-island.css": "./dist/activity-island.css",
    "./design-contract": {
      "types": "./dist/design-contract.d.ts",
      "import": "./dist/design-contract.js"
    },
    "./command-palette": {
      "types": "./dist/command-palette.d.ts",
      "import": "./dist/command-palette.js"
    },
    "./command-palette.css": "./dist/command-palette.css",
    "./composition": {
      "types": "./dist/composition.d.ts",
      "import": "./dist/composition.js"
    },
    "./composition.css": "./dist/composition.css"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && node scripts/compile-library.mjs && node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.workbench.json --noEmit",
    "test": "vitest run",
    "dev": "vite --host 0.0.0.0",
    "build:site": "vite build",
    "check": "npm run typecheck && npm test && npm run build && node scripts/verify-package.mjs && npm run build:site && npm run campaign:check",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "icons": "node scripts/sync-gitlab-icons.mjs",
    "campaign:report": "node scripts/campaign.mjs report",
    "campaign:check": "node scripts/campaign.mjs check"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@gitlab/svgs": "3.166.0",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vue/server-renderer": "^3.5.0",
    "jsdom": "^29.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rolldown": "1.2.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
